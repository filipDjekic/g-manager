<Application x:Class="GManager.Client.Shell.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="AppBackground" Color="#0A0C10"/>
  <SolidColorBrush x:Key="Surface" Color="#12151C"/>
  <SolidColorBrush x:Key="RaisedSurface" Color="#1A1F29"/>
  <SolidColorBrush x:Key="BorderColor" Color="#364050"/>
  <SolidColorBrush x:Key="Primary" Color="#55C8FF"/>
  <SolidColorBrush x:Key="Secondary" Color="#F587D1"/>
  <SolidColorBrush x:Key="PrimaryText" Color="#F1F4FA"/>
  <SolidColorBrush x:Key="MutedText" Color="#BCC5D4"/>
  <SolidColorBrush x:Key="Danger" Color="#FF9095"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{StaticResource RaisedSurface}"/><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/><Setter Property="Padding" Value="16,10"/>
   <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Secondary}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Primary}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{StaticResource RaisedSurface}"/><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="16"/>
   <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Background" Value="{StaticResource RaisedSurface}"/><Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="16"/>
   <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
  </Style>
 </Application.Resources>
</Application>
