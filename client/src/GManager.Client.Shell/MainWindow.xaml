<Window x:Class="GManager.Client.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GManager.Client.Shell.Views"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" Topmost="True"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI" FontSize="14" Title="G-Manager"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{StaticResource AppBackground}">
    <Grid x:Name="LayoutRoot" Background="{StaticResource AppBackground}" ClipToBounds="True" SizeChanged="LayoutRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BrandColumn" Width="3*"/>
            <ColumnDefinition x:Name="PanelColumn" Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="Branding" IsHitTestVisible="False" ClipToBounds="True">
            <Image Source="{StaticResource GamingRoomScene}" Stretch="UniformToFill" HorizontalAlignment="Center" Opacity="0.9"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#A60A0C10"/>
                        <GradientStop Color="#400A0C10" Offset="0.6"/>
                        <GradientStop Color="#F50A0C10" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#300A0C10"/>
                        <GradientStop Color="#700A0C10" Offset="0.35"/>
                        <GradientStop Color="#000A0C10" Offset="0.7"/>
                        <GradientStop Color="#F00A0C10" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid x:Name="BrandContent" Margin="72,60,48,46">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Path Data="{StaticResource BrandMarkGeometry}" Width="58" Height="64" Stretch="Uniform" Fill="{StaticResource BrandGradient}" Margin="0,0,18,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="G-MANAGER" FontSize="28" FontWeight="Bold" TextWrapping="NoWrap"/>
                        <TextBlock Text="G A M I N G   E X P E R I E N C E" FontSize="10" Foreground="{StaticResource MutedText}" Margin="1,5,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,35">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,24">
                        <Rectangle Width="24" Height="2" Fill="{StaticResource Primary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="TVOJE MESTO U IGRI" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Primary}"/>
                    </StackPanel>
                    <TextBlock x:Name="Slogan" FontFamily="Segoe UI Black" FontWeight="Black" FontSize="92" LineHeight="100" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap">
                        <Run Text="YOUR "/><Run Text="GAME." Foreground="{StaticResource Primary}"/>
                        <LineBreak/>
                        <Run Text="OUR "/><Run Text="SPACE." Foreground="{StaticResource Secondary}"/>
                    </TextBlock>
                    <TextBlock x:Name="Tagline" Text="Sve što ti treba za savršenu gaming sesiju."
                               FontSize="19" Foreground="{StaticResource MutedText}" Margin="5,26,0,0" MaxWidth="510" HorizontalAlignment="Left"/>
                    <Rectangle Width="136" Height="3" Fill="{StaticResource BrandGradient}" HorizontalAlignment="Left" Margin="5,30,0,0"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="4,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="G-MANAGER CLIENT" Style="{StaticResource Eyebrow}" FontSize="10"/>
                        <TextBlock x:Name="ClientVersion" Foreground="{StaticResource MutedText}" Opacity="0.65" FontSize="10" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Opacity="0.5">
                        <Rectangle Width="18" Height="2" Fill="{StaticResource Primary}" Margin="0,0,5,0"/>
                        <Rectangle Width="8" Height="2" Fill="{StaticResource Secondary}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" ClipToBounds="True">
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.7,0.15" GradientOrigin="0.7,0.15" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#1555C8FF"/>
                        <GradientStop Color="#000A0C10" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.9,0.85" GradientOrigin="0.9,0.85" RadiusX="0.7" RadiusY="0.6">
                        <GradientStop Color="#0DF587D1"/>
                        <GradientStop Color="#000A0C10" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid x:Name="PanelHost" Margin="28,42,64,42" MaxWidth="520" VerticalAlignment="Center">
                <Border CornerRadius="24" Background="#1055C8FF" Margin="1" IsHitTestVisible="False">
                    <Border.Effect><DropShadowEffect Color="#55C8FF" BlurRadius="40" ShadowDepth="0" Opacity="0.12"/></Border.Effect>
                </Border>
                <Border x:Name="SessionCard" Background="{StaticResource PanelSurface}" BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" CornerRadius="24" Padding="40">
                    <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly" Focusable="False" CanContentScroll="False">
                        <StackPanel>
                            <Border Style="{StaticResource StatusBadge}" Margin="0,0,0,30">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{StaticResource Primary}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Connectivity" Grid.Column="1" Text="Povezivanje sa servisom…" FontSize="12" Foreground="{StaticResource MutedText}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="PanelEyebrow" Text="DOBRO DOŠAO U IGRU" Style="{StaticResource Eyebrow}" FontSize="10" Foreground="{StaticResource Primary}" Margin="1,0,0,10"/>
                            <TextBlock x:Name="Heading" Text="Stanica je zaključana" FontSize="38" FontWeight="Bold" LineHeight="44" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock x:Name="Subtitle" Text="Za početak je potrebna aktivna sesija." FontSize="15" Foreground="{StaticResource MutedText}" Margin="1,10,0,0"/>
                            <Border x:Name="FormDivider" Height="1" Background="{StaticResource SubtleBorder}" Margin="0,28,0,28"/>

                            <Button x:Name="GuestLogin" Visibility="Collapsed" Content="POKRENI GOST SESIJU" Click="GuestLogin_Click" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Pokreni gost sesiju"/>
                            <StackPanel x:Name="LoginForm" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Continue">
                                <TextBox x:Name="Email" Tag="{StaticResource EmailGeometry}" Margin="0,0,0,16" TabIndex="0"
                                         AutomationProperties.Name="Email adresa" AutomationProperties.HelpText="Email adresa"
                                         InputMethod.IsInputMethodEnabled="False" SpellCheck.IsEnabled="False" IsUndoEnabled="False"/>
                                <Grid Margin="0,0,0,24">
                                    <PasswordBox x:Name="Password" Tag="Empty" TabIndex="1" PasswordChanged="Password_Changed"
                                                 AutomationProperties.Name="Lozinka"/>
                                    <TextBox x:Name="RevealedPassword" Visibility="Collapsed" Tag="{StaticResource LockGeometry}" Padding="50,0,52,0" TabIndex="1"
                                             AutomationProperties.Name="Prikazana lozinka" AutomationProperties.HelpText="Lozinka" TextChanged="RevealedPassword_Changed"
                                             IsUndoEnabled="False" SpellCheck.IsEnabled="False" ContextMenu="{x:Null}" InputMethod.IsInputMethodEnabled="False"/>
                                    <ToggleButton x:Name="RevealPassword" Style="{StaticResource RevealButton}" HorizontalAlignment="Right" Margin="0,0,5,0" TabIndex="2"
                                                  AutomationProperties.Name="Prikaži lozinku" ToolTip="Prikaži lozinku" Click="RevealPassword_Click"/>
                                </Grid>
                                <Button x:Name="Login" Style="{StaticResource PrimaryButton}" Click="Login_Click" IsDefault="True" TabIndex="3" AutomationProperties.Name="Prijavi se">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="LoginLabel" Text="PRIJAVI SE" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Path x:Name="LoginArrow" Data="{StaticResource ArrowGeometry}" Style="{StaticResource FieldIcon}" Stroke="{StaticResource AppBackground}" Width="19" Margin="16,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border x:Name="StationNotice" Style="{StaticResource InformationPanel}">
                                <StackPanel>
                                    <Border Width="52" Height="52" Background="#0E55C8FF" CornerRadius="14" HorizontalAlignment="Left" Margin="0,0,0,18">
                                        <Path x:Name="StateIcon" Data="{StaticResource LockGeometry}" Style="{StaticResource FieldIcon}" Stroke="{StaticResource Primary}" Width="25" Height="27"/>
                                    </Border>
                                    <TextBlock x:Name="StateTitle" Text="Tvoja sesija počinje ovde." FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StateDescription" Text="Za aktivaciju ove stanice obrati se osoblju. Ekran za prijavu pojaviće se kada sesija bude spremna."
                                               Foreground="{StaticResource MutedText}" FontSize="14" LineHeight="22" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ErrorPanel}" Margin="0,18,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource InfoGeometry}" Style="{StaticResource FieldIcon}" Stroke="{StaticResource Danger}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <TextBlock x:Name="Error" Grid.Column="1" Text="" Foreground="{StaticResource Danger}" FontSize="13" LineHeight="20" AutomationProperties.LiveSetting="Assertive"/>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="HelpText" Margin="0,28,0,0">
                                <TextBlock Text="Potreban je nalog za korišćenje ove stanice." Foreground="{StaticResource MutedText}" FontSize="12" TextAlignment="Center"/>
                                <TextBlock Text="Za pomoć se obratite osoblju." Foreground="{StaticResource MutedText}" FontSize="12" TextAlignment="Center" Margin="0,7,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom" Background="{StaticResource BrandGradient}" Opacity="0.5" IsHitTestVisible="False"/>
    </Grid>
    <views:DashboardView x:Name="Dashboard" Visibility="Collapsed"/>
    </Grid>
</Window>
