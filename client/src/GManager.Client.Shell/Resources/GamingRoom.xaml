    <!-- Original, resolution-independent room illustration. No external image or font assets. -->
    <LinearGradientBrush x:Key="MonitorGlass" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#12151C"/>
        <GradientStop Color="#2755C8FF" Offset="0.6"/>
        <GradientStop Color="#7055C8FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RoomFloor" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1A1F29"/>
        <GradientStop Color="#0A0C10" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="RoomBlueLight">
        <GradientStop Color="#4055C8FF"/>
        <GradientStop Color="#0055C8FF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="RoomPinkLight">
        <GradientStop Color="#38F587D1"/>
        <GradientStop Color="#00F587D1" Offset="1"/>
    </RadialGradientBrush>
