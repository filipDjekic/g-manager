<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackground" Color="#0A0C10"/>
    <SolidColorBrush x:Key="Surface" Color="#12151C"/>
    <SolidColorBrush x:Key="RaisedSurface" Color="#1A1F29"/>
    <SolidColorBrush x:Key="BorderColor" Color="#364050"/>
    <SolidColorBrush x:Key="Primary" Color="#55C8FF"/>
    <SolidColorBrush x:Key="Secondary" Color="#F587D1"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#F1F4FA"/>
    <SolidColorBrush x:Key="MutedText" Color="#BCC5D4"/>
    <SolidColorBrush x:Key="Warning" Color="#F6CD72"/>
    <SolidColorBrush x:Key="Danger" Color="#FF9095"/>
    <!-- Green is reserved for the explicitly confirmed connection status. -->
    <SolidColorBrush x:Key="Connected" Color="#8CDDB0"/>
    <SolidColorBrush x:Key="InputSurface" Color="#DA1A1F29"/>
    <SolidColorBrush x:Key="SubtleBorder" Color="#70364050"/>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#55C8FF"/>
        <GradientStop Color="#BCC5D4" Offset="0.5"/>
        <GradientStop Color="#F587D1" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelSurface" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F01A1F29"/>
        <GradientStop Color="#F512151C" Offset="0.5"/>
        <GradientStop Color="#F00E1118" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9055C8FF"/>
        <GradientStop Color="#40364050" Offset="0.28"/>
        <GradientStop Color="#60364050" Offset="0.75"/>
        <GradientStop Color="#70F587D1" Offset="1"/>
    </LinearGradientBrush>

    <Geometry x:Key="BrandMarkGeometry">M 22,2 L 42,2 50,10 42,18 28,18 18,28 18,40 28,50 40,50 40,38 30,38 30,26 54,26 54,52 44,62 22,62 2,42 2,22 Z</Geometry>
    <Geometry x:Key="EmailGeometry">M 2,4 L 22,4 22,20 2,20 Z M 2,5 L 12,13 22,5</Geometry>
    <Geometry x:Key="LockGeometry">M 5,10 L 19,10 19,22 5,22 Z M 8,10 L 8,6 A 4,4 0 0 1 16,6 L 16,10 M 12,15 L 12,18</Geometry>
    <Geometry x:Key="ArrowGeometry">M 3,12 L 21,12 M 14,5 L 21,12 14,19</Geometry>
    <Geometry x:Key="EyeGeometry">M 2,12 C 7,3 17,3 22,12 C 17,21 7,21 2,12 Z M 15,12 A 3,3 0 1 1 9,12 A 3,3 0 1 1 15,12</Geometry>
    <Geometry x:Key="OfflineGeometry">M 3,9 Q 12,1 21,9 M 6,13 Q 12,7 18,13 M 9,17 Q 12,14 15,17 M 12,21 L 12,21.1 M 2,2 L 22,22</Geometry>
    <Geometry x:Key="MaintenanceGeometry">M 14,3 A 6,6 0 0 0 7,10 L 2,15 2,21 8,21 13,16 A 6,6 0 0 0 21,8 L 17,12 12,7 16,3 Z</Geometry>
    <Geometry x:Key="InfoGeometry">M 12,2 A 10,10 0 1 1 11.99,2 M 12,10 L 12,17 M 12,6 L 12,7</Geometry>
    <Geometry x:Key="GameGeometry">M 8,6 L 16,6 Q 20,6 21,11 L 23,18 Q 23,22 19,20 L 15,17 9,17 5,20 Q 1,22 1,18 L 3,11 Q 4,6 8,6 Z M 6,10 L 6,15 M 3.5,12.5 L 8.5,12.5 M 17,10 L 17,11 M 20,13 L 20,14</Geometry>

    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="FieldIcon" TargetType="Path">
        <Setter Property="Width" Value="19"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{StaticResource MutedText}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="56"/>
        <Setter Property="Background" Value="{StaticResource InputSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="50,0,16,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Primary}"/>
        <Setter Property="SelectionOpacity" Value="0.3"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TextBox">
                <Border x:Name="Field" Background="{TemplateBinding Background}" CornerRadius="10"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid>
                        <Path x:Name="Icon" Data="{TemplateBinding Tag}" Style="{StaticResource FieldIcon}" HorizontalAlignment="Left" Margin="18,0,0,0"/>
                        <TextBlock x:Name="Watermark" Visibility="Collapsed" IsHitTestVisible="False"
                                   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(AutomationProperties.HelpText)}"
                                   Foreground="{StaticResource MutedText}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Text" Value=""><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource BorderColor}"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Primary}"/>
                        <Setter TargetName="Field" Property="Background" Value="{StaticResource RaisedSurface}"/>
                        <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource Primary}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="56"/>
        <Setter Property="Background" Value="{StaticResource InputSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="50,0,52,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Primary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="PasswordBox">
                <Border x:Name="Field" Background="{TemplateBinding Background}" CornerRadius="10"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid>
                        <Path x:Name="Icon" Data="{StaticResource LockGeometry}" Style="{StaticResource FieldIcon}" HorizontalAlignment="Left" Margin="18,0,0,0"/>
                        <TextBlock x:Name="Watermark" Text="Lozinka" Visibility="Collapsed" IsHitTestVisible="False"
                                   Foreground="{StaticResource MutedText}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Tag" Value="Empty"><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource BorderColor}"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Primary}"/>
                        <Setter TargetName="Field" Property="Background" Value="{StaticResource RaisedSurface}"/>
                        <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource Primary}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource RaisedSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,14"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource Primary}"/>
                        <Setter TargetName="ButtonSurface" Property="Background" Value="#29364050"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.7"/>
                        <Setter TargetName="ButtonSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.99" ScaleY="0.99"/></Setter.Value></Setter>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource Primary}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="58"/>
        <Setter Property="Foreground" Value="{StaticResource AppBackground}"/>
        <Setter Property="Background" Value="{StaticResource Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Grid RenderTransformOrigin="0.5,0.5" x:Name="ButtonRoot">
                    <Border x:Name="Glow" CornerRadius="10" Background="{StaticResource Primary}" Opacity="0.16" IsHitTestVisible="False">
                        <Border.Effect><DropShadowEffect Color="#55C8FF" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                    </Border>
                    <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ButtonSurface" Property="Background" Value="#88D8FF"/>
                        <Setter TargetName="Glow" Property="Opacity" Value="0.45"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource PrimaryText}"/>
                        <Setter TargetName="Glow" Property="Opacity" Value="0.45"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ButtonSurface" Property="Background" Value="#3EAADB"/>
                        <Setter TargetName="ButtonRoot" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.985" ScaleY="0.985"/></Setter.Value></Setter>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/>
                        <Setter TargetName="Glow" Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="RevealButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="ToggleSurface" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
                    <Grid>
                        <Path Data="{StaticResource EyeGeometry}" Style="{StaticResource FieldIcon}" Stroke="{TemplateBinding Foreground}"/>
                        <Path x:Name="Slash" Data="M 4,4 L 20,20" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Primary}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Slash" Property="Visibility" Value="Visible"/>
                        <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{StaticResource Primary}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ToggleSurface" Property="Background" Value="{StaticResource RaisedSurface}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ToggleSurface" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="Background" Value="#0D55C8FF"/>
        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="InformationPanel" TargetType="Border">
        <Setter Property="Background" Value="#701A1F29"/>
        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="ErrorPanel" TargetType="Border" BasedOn="{StaticResource InformationPanel}">
        <Setter Property="Background" Value="#0FFF9095"/>
        <Setter Property="BorderBrush" Value="#50FF9095"/>
        <Setter Property="Padding" Value="14"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, ElementName=Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
