{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g-manager.local/contracts/gaming-machine-protocol-v1.schema.json",
  "title": "G-Manager machine protocol envelope v1",
  "description": "Machine protocol contracts, including signed server-authoritative time balance leases.",
  "oneOf": [
    {
      "$ref": "#/$defs/stationSnapshot"
    },
    {
      "$ref": "#/$defs/stationCommand"
    },
    {
      "$ref": "#/$defs/commandAcknowledgement"
    },
    {
      "$ref": "#/$defs/sessionLease"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "stationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stationId",
        "serverTime",
        "commandCursor"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "stationId": {
          "$ref": "#/$defs/uuid"
        },
        "serverTime": {
          "$ref": "#/$defs/instant"
        },
        "commandCursor": {
          "type": "integer",
          "minimum": 0
        },
        "session": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "sessionId",
            "customerId",
            "startedAt",
            "endsAt",
            "status"
          ],
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/uuid"
            },
            "customerId": {
              "$ref": "#/$defs/uuid"
            },
            "startedAt": {
              "$ref": "#/$defs/instant"
            },
            "endsAt": {
              "$ref": "#/$defs/instant"
            },
            "status": {
              "enum": [
                "ACTIVE",
                "EXPIRED",
                "TERMINATED"
              ]
            }
          }
        }
      }
    },
    "stationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stationId",
        "sequence",
        "commandId",
        "type",
        "correlationId"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "stationId": {
          "$ref": "#/$defs/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "commandId": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "enum": [
            "SESSION_STARTED",
            "SESSION_EXTENDED",
            "SESSION_TERMINATED",
            "CONFIG_UPDATED",
            "LOCK"
          ]
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "commandAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stationId",
        "sequence",
        "commandId",
        "outcome",
        "enforcedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "stationId": {
          "$ref": "#/$defs/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "commandId": {
          "$ref": "#/$defs/uuid"
        },
        "outcome": {
          "enum": [
            "APPLIED",
            "ALREADY_APPLIED",
            "FAILED"
          ]
        },
        "enforcedAt": {
          "$ref": "#/$defs/instant"
        },
        "failureCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "sessionLease": {
      "type": "object",
      "required": [
        "leaseId",
        "stationId",
        "issuedAt",
        "expiresAt",
        "graceEndsAt",
        "commandCursor",
        "directive"
      ],
      "properties": {
        "leaseId": {
          "$ref": "#/$defs/uuid"
        },
        "stationId": {
          "$ref": "#/$defs/uuid"
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "customerId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "sessionEndsAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "configurationVersion": {
          "type": "integer",
          "minimum": 0
        },
        "issuedAt": {
          "$ref": "#/$defs/instant"
        },
        "expiresAt": {
          "$ref": "#/$defs/instant"
        },
        "graceEndsAt": {
          "$ref": "#/$defs/instant"
        },
        "commandCursor": {
          "type": "integer",
          "minimum": 0
        },
        "directive": {
          "enum": [
            "ACTIVE",
            "LOCK"
          ]
        },
        "billingMode": {
          "enum": [
            "TIME_BALANCE",
            "FIXED_DURATION",
            "PREPAID_METERED",
            null
          ]
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "balanceSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "assignmentId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "assignmentExpiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "description": "A waiting assignment is a LOCK directive with assignmentId and no active session or countdown. TIME_BALANCE active leases have no offline grace beyond expiresAt. Balance is telemetry; the server ledger is authoritative."
    },
    "sessionLogoutRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId"
      ],
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/uuid"
        },
        "reason": {
          "enum": [
            "CUSTOMER_FINISH",
            "CLIENT_RECOVERY",
            null
          ]
        }
      },
      "description": "Station-bound termination is idempotent. CLIENT_RECOVERY closes old access after Service restart; server time and the previously signed lease cap consumption."
    }
  }
}
