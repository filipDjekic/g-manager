DEPLOY_ENV=staging
APP_RELEASE=git-sha
BACKEND_IMAGE=ghcr.io/example/gmanager-backend@sha256:replace-with-digest
FRONTEND_IMAGE=ghcr.io/example/gmanager-frontend@sha256:replace-with-digest
CANONICAL_ORIGIN=https://staging.gmanager.example
APP_PORT=8080
DEPLOY_SECRETS_DIR=/var/lib/gmanager/secrets
DEPLOY_STATE_DIR=/var/lib/gmanager/state
CLIENT_RELEASES_DIR=/var/lib/gmanager/client-releases
ENABLE_TLS=true
ENABLE_MONITORING=true
INITIAL_OWNER_EMAIL=owner@example.test
INITIAL_OWNER_NAME=Initial Owner
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
BACKUP_RESTORE_INTERVAL=7
RESTIC_REPOSITORY=s3:https://backup.example/dedicated-bucket/prefix
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_S3_ENDPOINT=https://s3.example
DOCUMENT_S3_REGION=eu-central-1
DOCUMENT_S3_BUCKET=gmanager-staging
AI_PROVIDER=disabled
AI_ENDPOINT=https://provider.example/v1/report-summary
AI_MODEL=approved-model-version
STATION_POLICY_SIGNING_KEY_ID=production-key-id
STATION_POLICY_SIGNING_PUBLIC_KEY=base64-public-SPKI
GAMING_CLIENT_VERSION=1.0.0
GAMING_CLIENT_MINIMUM_VERSION=1.0.0
GAMING_CLIENT_DOWNLOAD_URL=https://downloads.example/GManager.Client.zip
GAMING_CLIENT_SHA256=64-lowercase-hex-characters
GAMING_CLIENT_PACKAGE_SIGNING_SUBJECT=CN=Your Organization Code Signing
GAMING_CLIENT_PACKAGE_SIGNING_THUMBPRINT=40-hex-characters
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# MIGRATION_DB_PASSWORD is mandatory but must be injected by the protected runner,
# never persisted in this file or in public release JSON.
