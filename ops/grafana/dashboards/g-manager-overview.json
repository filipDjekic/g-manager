        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Auth and rate-limit outcomes",
      "targets": [
        {
          "expr": "sum by (status) (rate(gmanager_http_requests_seconds_count{route=~\"/api/v1/auth/.*\",status=~\"401|429\"}[5m]))"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      }
    },
