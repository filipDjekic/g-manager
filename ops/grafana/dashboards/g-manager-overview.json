{
  "annotations": {
    "list": []
  },
  "editable": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "targets": [
        {
          "expr": "sum(rate(gmanager_http_requests_seconds_count[5m]))"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Server error rate",
      "targets": [
        {
          "expr": "sum(rate(gmanager_http_requests_seconds_count{outcome=\"SERVER_ERROR\"}[5m]))"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Request p95 latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gmanager_http_requests_seconds_bucket[5m])))"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      }
    },
    {
      "type": "stat",
